# ─────────────────────────────────────────────────────────────
# 环境变量清单
# 复制为 .env 后逐项填写：cp .env.example .env
# 生产环境（Vercel）请在平台面板配置，不要提交此文件
# 完整部署步骤见 docs/DEPLOY.md
# ─────────────────────────────────────────────────────────────

# ── 数据库（必填）─────────────────────────────────────────────
# 本地开发：node scripts/db.mjs start 后使用下面这行
#   postgresql://shop:shoppw@127.0.0.1:55432/shopdev?schema=public
#
# 生产（Neon 免费版）：见 docs/DEPLOY.md 第二步
#   DATABASE_URL = 连接池串（主机名含 -pooler）← Serverless 必须用这个
#   DIRECT_URL   = 直连串（主机名不含 -pooler）← 仅 migrate 用
DATABASE_URL=""
DIRECT_URL=""

# ── NextAuth 认证（必填）─────────────────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 本地/局域网：留空让 Auth.js 按请求 Host 自动推断
# ⚠️ 不要写死 AUTH_URL=http://localhost:3000，
#    否则别人用 IP 或 Vercel 域名访问时登录会失败
AUTH_TRUST_HOST="true"

# ── 管理员（必填）────────────────────────────────────────────
# 与数据库 User.email 一致；逗号分隔可配多个
ADMIN_EMAILS="1232456"

# ── 门店展示 ─────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="长夜烟花"

# ── 图片存储（生产必填）──────────────────────────────────────
# Vercel 文件系统只读，商品图必须存 Vercel Blob。
# 在 Vercel 项目 → Storage → Create Blob 后自动生成。
# 本地开发留空即可，会写到 public/uploads/
BLOB_READ_WRITE_TOKEN=""

# ── 部署提示 ─────────────────────────────────────────────────
# 多实例/自建服务器部署时设置，用于跨实例解密 Server Action 闭包。
# Vercel 单项目可留空由平台生成。
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── P1 支付（现在不要填）─────────────────────────────────────
# 注意：烟花爆竹属于特许经营商品，线上支付通道对类目有严格限制。
# 接入前先确认收单机构是否允许该品类，且需《烟花爆竹经营（零售）许可证》
# 与已备案域名。多数地区还要求线下实名登记购买人。
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# ── 实名登记（烟花销售合规，建议启用）───────────────────────
# 打开后下单需填写姓名与身份证号，仅存脱敏值用于到店核验
# ENABLE_REALNAME_CHECK="true"
