# ─────────────────────────────────────────────────────────────
# 环境变量清单
# 复制为 .env 后逐项填写：cp .env.example .env
# 生产环境（Vercel / 云服务器）请在平台面板配置，不要提交此文件
# ─────────────────────────────────────────────────────────────

# ── 数据库（必填）─────────────────────────────────────────────
# 本地开发：node scripts/db.mjs start 后使用下面这行
#   postgresql://shop:shoppw@127.0.0.1:55432/shopdev?schema=public
#
# 生产（Supabase 免费版）：
#   DATABASE_URL = 连接池串（Transaction pooler，端口 6543）
#     postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = 直连串（Session pooler / 5432），仅 migrate 用
#     postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 生产（Neon 免费版）：
#   DATABASE_URL = 连接池串（主机名含 -pooler）
#   DIRECT_URL   = 直连串（去掉 -pooler）
DATABASE_URL=""
# Prisma migrate 用的直连地址；本地可与 DATABASE_URL 相同
DIRECT_URL=""

# ── NextAuth 认证（必填）─────────────────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 生产环境必须换新值，且更换后所有用户需要重新登录
AUTH_SECRET=""
# 本地 http://localhost:3000；生产填正式域名 https://your-domain.com
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── 管理员（P1 后台用）────────────────────────────────────────
# 逗号分隔的邮箱列表，role=ADMIN 也可；两者满足其一即可
ADMIN_EMAILS="admin@example.com"

# ── 门店展示（可选，seed 与首页用）───────────────────────────
NEXT_PUBLIC_STORE_NAME="长夜烟花"

# ── 部署提示 ─────────────────────────────────────────────────
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY：多实例/自建服务器部署时必须设置，
# 用于跨实例解密 Server Action 闭包；Vercel 单项目可留空由平台生成。
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── P1 支付（现在不要填）─────────────────────────────────────
# 注意：烟花爆竹属于特许经营商品，线上支付通道对类目有严格限制。
# 接入前先确认收单机构是否允许该品类，且需《烟花爆竹经营（零售）许可证》
# 与已备案域名。多数地区还要求线下实名登记购买人。
# ALIPAY_APP_ID=""
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# ── 实名登记（烟花销售合规，建议启用）───────────────────────
# 打开后下单需填写姓名与身份证号，仅存脱敏值用于到店核验
# ENABLE_REALNAME_CHECK="true"
